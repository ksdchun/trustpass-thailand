# Azure AI Foundry (OpenAI-compatible v1 endpoint)
# Endpoint must end with /openai/v1
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project/openai/v1
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Required only for classic Azure OpenAI endpoints such as https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TIMEOUT_MS=12000

# Azure AI Services shared endpoint/key from Foundry.
# This same key can be used by Document Intelligence, Vision, Speech, etc.
AZURE_AI_SERVICES_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_AI_SERVICES_API_KEY=your-key

# Azure AI Document Intelligence
# Optional override. If unset, TrustPass uses AZURE_AI_SERVICES_ENDPOINT/API_KEY,
# then tries to infer https://<resource>.cognitiveservices.azure.com from AZURE_OPENAI_ENDPOINT.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-key
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_MS=10000

# Optional: Azure Maps route distance grounding. If unset, TrustPass uses local curated route estimates.
AZURE_MAPS_KEY=your-azure-maps-key
AZURE_MAPS_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Strict JSON-schema mode + reproducibility
# ---------------------------------------------------------------------------
# Seed passed to Azure OpenAI for reproducible scoring across recordings.
# Any positive integer works; 42 is the team default so evals stay comparable.
AZURE_OPENAI_SEED=42

# ---------------------------------------------------------------------------
# Azure Content Safety — Prompt Shields (optional, graceful degrade)
# ---------------------------------------------------------------------------
# Adds a preflight check for jailbreak attempts and indirect prompt injection
# in OCR text. If unset, TrustPass still defends via the in-prompt sanitizer
# (lib/sanitize-evidence.ts) and the system-prompt USER_EVIDENCE delimiters.
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=your-content-safety-key

# ---------------------------------------------------------------------------
# DEMO_MODE — cinematic recording continuity
# ---------------------------------------------------------------------------
# When "true", /api/situation/analyze short-circuits the hero scenarios to
# hand-tuned cached responses in data/cached_responses/*.json and the OCR
# pipeline returns curated transcripts. Use this to record the pitch video
# with zero live-API variability. Set to "false" (or omit) for normal use.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Telemetry (optional)
# ---------------------------------------------------------------------------
# Application Insights connection string for the /responsible-ai page and
# eval pipeline. Telemetry events follow the key names in INTERFACE_CONTRACT.md.
APPLICATIONINSIGHTS_CONNECTION_STRING=
